{
  "dependencies": {
    "@celluloid/api": "workspace:*",
    "@celluloid/i18n": "workspace:*",
    "@celluloid/ui": "workspace:*",
    "@tamagui/config": "^2.7.7",
    "@tamagui/core": "^2.7.7",
    "@tamagui/web": "^2.7.7",
    "@tanstack/react-query": "^5.90.2",
    "next": "~16.1.6",
    "next-intl": "^4.14.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tamagui": "^2.7.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tamagui/cli": "^2.7.7"
  },
  "name": "@celluloid/web",
  "nx": {
    "sourceRoot": "apps/web/src",
    "targets": {
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt --write {projectRoot}"
        }
      }
    }
  },
  "private": true,
  "scripts": {
    "build": "tamagui build --target web ./src -- next build",
    "dev": "next dev --turbopack",
    "start": "next start"
  },
  "version": "0.0.1"
}
