# Copy this file to infra/env/.env and fill in real values. 

# --- Django -----------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import
# get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Comma-separated.
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database -----------------------------------------------------------
POSTGRES_DB=celluloid
POSTGRES_USER=celluloid
POSTGRES_PASSWORD=celluloid # change me

# --- Object storage (MinIO) ---------------------------------------------
MINIO_ROOT_USER=celluloid
MINIO_ROOT_PASSWORD=celluloid # change me
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_BUCKET_NAME=celluloid-media

# --- Web ------------------------------------------------------------------
# Dev: http://localhost:8000 (direct, no Caddy in front).
# Prod: https://api.<your domain>, once Caddy is fronting the backend —
# see DOMAIN below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Reverse proxy (Caddy) — prod only ------------------------------------
# The domain Caddy requests a certificate for. api.<DOMAIN> is used
# automatically for the backend — see infra/caddy/Caddyfile.prod.
DOMAIN=
# Let's Encrypt sends renewal/expiry notices here. Any address works.
CADDY_ACME_EMAIL=
